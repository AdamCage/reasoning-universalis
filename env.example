# Reasoning Universalis — minimal configuration for EpistemeOS experiments
# Cursor is the research harness. No separate LLM judges, writers or agents.
# RouterAI is used ONLY for experimental open-weight LLMs and two open embeddings.
# This is a proposed configuration contract for reasoning_universalis_v1:
# current EpistemeOS does not automatically load these RU_* settings.
# Copy to .env and insert the RouterAI API key. NEVER commit .env to git.

# --- The only secret ------------------------------------------------------------
ROUTERAI_API_KEY=

# --- One API for experimental LLMs and embeddings ------------------------------
ROUTERAI_BASE_URL=https://routerai.ru/api/v1

# --- Experimental models (open weights, NOT research agents) -------------------
# Five proposed models + independent NVIDIA Mamba2/Transformer MoE family.
# Exact RouterAI IDs verified from their public catalog on 2026-10-11.
RU_MODELS=qwen/qwen3-8b,qwen/qwen3.8-27b,openai/gpt-oss-20b,meta/muse-glimmer-30b,google/gemma-4-31b-it,nvidia/nemotron-3-nano-30b-a3b

# --- Exactly two open embedding models -----------------------------------------
# BGE-M3: 1024 dimensions; Qwen3-Embedding-8B: up to 4096 dimensions.
# Compare results within each representation; do NOT compare raw vectors across them.
RU_EMBEDDING_MODELS=baai/bge-m3,qwen/qwen3-embedding-8b

# --- Pilot settings ------------------------------------------------------------
RU_PHASE=pilot
RU_DOMAINS=math,logic,algorithms,planning
RU_TASKS_PER_DOMAIN=10
RU_SAMPLES_PER_TASK=2
RU_SEED=42
RU_TEMPERATURE=0.7
RU_TOP_P=0.95
RU_MAX_OUTPUT_TOKENS=8192

# --- Raw reasoning and reproducibility ----------------------------------------
# Must be verified by an actual API probe for EACH model before measurements.
# A provider may support include_reasoning without returning usable full traces.
RU_INCLUDE_REASONING=true
RU_REQUIRE_VISIBLE_REASONING=true
RU_REJECT_REASONING_SUMMARIES=true
RU_PREFLIGHT_EACH_MODEL=true
RU_SAVE_RAW_RESPONSES=true
RU_AUTO_MODEL_SUBSTITUTION=false

# --- Simple analysis: no LLM-based segmenter or judge --------------------------
# More methods/thresholds belong in a versioned, frozen scientific protocol.
RU_SEGMENTATION=sentence

# --- Limits and research data --------------------------------------------------
RU_MAX_CONCURRENT_REQUESTS=3
RU_REQUEST_TIMEOUT_SECONDS=900
RU_MAX_SPEND_RUB=900
RU_RESEARCH_ROOT=.research/reasoning-universalis
RU_EPISTEME_ROOT=.research/reasoning-universalis/store
RU_CHECKPOINT_DIR=.research/reasoning-universalis-checkpoints

# Important:
# * RU_MAX_SPEND_RUB is NOT a hard limit until enforced by application code.
# * RouterAI may route the same slug to different upstream providers/quantizations.
#   Save response, usage and routing/endpoint metadata when available.
# * Research agents, literature review, code, tests and manuscript are handled
#   by the Cursor harness; no additional model keys or roles are configured.
# * All experimental weights are downloadable, but RouterAI is a commercial
#   hosted service, not an open-source inference backend.
# * NVIDIA Nemotron weights have a custom NVIDIA Open Model License.
